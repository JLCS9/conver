# Converflow reverse proxy.
# Caddy v2 auto-renews Let's Encrypt SSL for every hostname declared here.
#
# Transition note: we are on api.converflow.tech while the converflow.ai
# domain transfer completes. When .ai is back, add a second block for
# api.converflow.ai (or replace .tech with .ai) — Caddy will re-issue SSL
# automatically on next reload.

{
	# Global options
	email jose@csodigital.tech
	# Default ACME issuer is Let's Encrypt production; uncomment for staging:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

api.converflow.tech {
	encode gzip zstd

	# Forward everything to the Next.js backend on the docker network.
	reverse_proxy backend:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Sensible security headers.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Disable noisy server header
		-Server
	}

	log {
		output stdout
		format console
		level INFO
	}
}
