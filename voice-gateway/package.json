{
  "name": "converflow-voice-gateway",
  "version": "0.2.0",
  "private": true,
  "description": "WebSocket gateway that orchestrates Deepgram STT + Gemini text + ElevenLabs TTS for mobile voice sessions.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^1.13.0",
    "@deepgram/sdk": "^3.9.0",
    "@google/genai": "^0.7.0",
    "@supabase/supabase-js": "^2.45.0",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
