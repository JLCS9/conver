# Converflow backend environment.
# Copy this to .env.local on the VPS (NEVER commit .env.local).
# Values left blank are not yet needed for the /api/health milestone.

NODE_ENV=production
PORT=3000

# --- Clerk ---
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Google AI (Gemini Live) ---
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# --- Apple IAP ---
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=ai.converflow.app

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@converflow.ai

# --- PostHog ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Sentry (server-side) ---
# DSN from Sentry project settings. Leave blank in dev — Sentry init is
# a no-op without it. When set, errors and 0.1 of traces are forwarded.
SENTRY_DSN=
SENTRY_RELEASE=

# --- Expo Push ---
EXPO_ACCESS_TOKEN=

# --- Internal ---
INTERNAL_CRON_SECRET=
APP_URL=https://converflow.ai
